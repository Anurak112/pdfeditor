{
  "name": "simple-pdf-editor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Simple PDF Editor — ค้นหาและแทนที่ข้อความใน PDF โดยไม่ทิ้งร่องรอย ทำงานในเครื่อง 100%",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx tests/run.ts",
    "build:single": "vite build --mode singlefile && node -e \"require('fs').copyFileSync('dist-single/index.html','PDF-Editor.html')\"",
    "job": "tsx tests/make-output.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}